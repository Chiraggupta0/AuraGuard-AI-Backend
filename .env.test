# Dummy values used only when running the Jest test suite (NODE_ENV=test).
# tests/setup.js spins up an in-memory MongoDB, so MONGO_URI_TEST is unused
# but kept here for parity with env.js.
NODE_ENV=test
PORT=5001
API_VERSION=v1
CLIENT_URL=http://localhost:3000

MONGO_URI_TEST=mongodb://127.0.0.1:27017/auraguard_ai_test

JWT_ACCESS_SECRET=test_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=test_cookie_secret

BCRYPT_SALT_ROUNDS=4

CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=test
EMAIL_FROM=AuraGuard AI <no-reply@auraguard.ai>

AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=test
AI_SERVICE_TIMEOUT_MS=2000
AI_SERVICE_MAX_RETRIES=1
AI_SERVICE_RETRY_DELAY_MS=50

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

LOG_LEVEL=error
